# Frontend env, copy to .env for local dev. Vite only exposes VITE_* vars.

# Base URL for the API. Leave unset in dev, Vite proxies /api to :4000.
# VITE_API_URL=

# Google OAuth 2.0 Web client ID (from Google Cloud Console → Credentials).
# The client's "Authorized JavaScript origins" MUST include:
#   http://localhost:5173
# The Google sign-in button only renders when this is set.
VITE_GOOGLE_CLIENT_ID=
